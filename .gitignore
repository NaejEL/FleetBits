# Journaux d'exécution headless de l'usine
factory-logs/

# Environnements virtuels Python de travail (venv du dépôt -platform, hors dépôt)
.venv/
.venv-platform/

# Caches Python
__pycache__/
.pytest_cache/

# Éditeur / OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

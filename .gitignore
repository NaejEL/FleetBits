# Monorepo FleetBits — racine du dépôt git unique.
# Les .gitignore de api/, ui/, agent/ et platform/ complètent celui-ci pour leur
# propre sous-arbre.

# Journaux d'exécution headless de l'usine
factory-logs/

# Environnements virtuels Python (celui de platform/ vit à la racine : son
# .gitignore n'ignore pas .venv/)
.venv/
.venv-platform/

# Caches Python
__pycache__/
.pytest_cache/

# Éditeur / OS
.DS_Store
Thumbs.db
*.swp
*.swo
*~

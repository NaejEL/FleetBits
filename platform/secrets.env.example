# ============================================================
# FleetBits Platform — VPS environment variables
# Copy to secrets.env and fill in generated values.
# NEVER commit secrets.env to git.
# ============================================================

# ------------------------------------
# Public domain (no trailing slash)
# ------------------------------------
FLEET_DOMAIN=fleet.example.com

# ------------------------------------
# PostgreSQL superuser password
# Generate: openssl rand -base64 24
# ------------------------------------
POSTGRES_PASSWORD=CHANGE_ME

# ------------------------------------
# Per-service database passwords
# ------------------------------------
FLEET_DB_PASSWORD=CHANGE_ME
SEMAPHORE_DB_PASSWORD=CHANGE_ME

# ------------------------------------
# Grafana admin UI password
# ------------------------------------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------
# Grafana Auth Proxy shared secret
# Caddy injects this header; Fleet API validates it to prevent header injection.
# Generate: openssl rand -base64 32
# ------------------------------------
GRAFANA_PROXY_SECRET=CHANGE_ME

# ------------------------------------
# Semaphore REST API key
# Fleet API uses this to trigger Ansible jobs.
# Generate: openssl rand -hex 32
# ------------------------------------
SEMAPHORE_API_KEY=CHANGE_ME

# ------------------------------------
# Fleet API JWT signing secret
# Generate: openssl rand -base64 48
# ------------------------------------
FLEET_JWT_SECRET=CHANGE_ME

# ------------------------------------
# Mosquitto broker credentials (internal MQTT + exporter)
# Generate: openssl rand -base64 24
# ------------------------------------
MQTT_BROKER_USERNAME=fleet_exporter
MQTT_BROKER_PASSWORD=CHANGE_ME

# ------------------------------------
# Fleet API operator token (for Mosquitto ACL sync)
# Leave empty to disable per-device ACL sync. Generate via Fleet API once deployed.
# ------------------------------------
FLEET_OPERATOR_TOKEN=

# ------------------------------------
# Secret separation (required)
# - FLEET_UI_SECRET_KEY: Flask session signing secret
# - SEMAPHORE_ACCESS_KEY_ENCRYPTION_KEY: Semaphore key encryption secret
# - SEMAPHORE_ADMIN_PASSWORD: dedicated Semaphore admin password
# ------------------------------------
FLEET_UI_SECRET_KEY=CHANGE_ME
SEMAPHORE_ACCESS_KEY_ENCRYPTION_KEY=CHANGE_ME
SEMAPHORE_ADMIN_PASSWORD=CHANGE_ME

# ------------------------------------
# Fleet API internal URL (used by fleet-ui to proxy requests)
# Not exposed publicly — Docker-internal only.
# ------------------------------------
FLEETBITS_API_IMAGE=ghcr.io/<github-owner>/fleetbits-api:latest
FLEETBITS_UI_IMAGE=ghcr.io/<github-owner>/fleetbits-ui:latest
FLEET_API_INTERNAL_URL=http://fleet-api:8000

# ------------------------------------
# Grafana internal URL (used by fleet-ui to build iframe URLs)
# ------------------------------------
GRAFANA_INTERNAL_URL=http://grafana:3000

# ------------------------------------
# aptly GPG key ID (created during first-time setup)
# Used to sign .deb packages.
# ------------------------------------
APTLY_GPG_KEY_ID=CHANGE_ME

# ------------------------------------
# Environment tag injected into logs/metrics (do not change in prod)
# ------------------------------------
FLEET_ENV=production

# ------------------------------------
# Explicit runtime safety flags
# - ALLOW_ALL_ORIGINS must stay false outside local development
# - FLASK_DEBUG must stay false outside local development
# ------------------------------------
ALLOW_ALL_ORIGINS=false
FLASK_DEBUG=false

# ------------------------------------
# Telemetry ingest hardening (device -> fleet-api -> Prometheus/Loki)
# Keep true in production. Set false only for temporary migration rollback.
# ------------------------------------
TELEMETRY_AUTH_REQUIRED=true
TELEMETRY_PROXY_TIMEOUT_SECONDS=15

# ------------------------------------
# Alertmanager UI basic auth (via Caddy /alertmanager route)
# User can stay 'admin'; generate hash with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-strong-password'
# ------------------------------------
ALERTMANAGER_BASIC_AUTH_USER=admin
ALERTMANAGER_BASIC_AUTH_HASH=CHANGE_ME_BCRYPT_HASH

# ------------------------------------
# VPS device token — issued by: scripts/enroll-vps.ps1
# Lets the vps-device container authenticate heartbeats to Fleet API.
# Generate once, then keep in secrets.env (never commit).
# ------------------------------------
VPS_DEVICE_TOKEN=CHANGE_ME

# ------------------------------------
# Aptly authorized-device key sync interval (seconds)
# aptly-api periodically fetches /api/v1/packages/repo-authorized-keys
# and writes consumed allowlist snapshots into /root/.aptly/security.
# ------------------------------------
REPO_KEY_SYNC_INTERVAL_SECONDS=300

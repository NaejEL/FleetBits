{#
  Fleet Agent Identity — generated by Ansible, do not edit manually.

  This is the "automation path" producer of the device identity contract.
  Key list source of truth: api/app/contracts/device_identity.py;
  agent-side copy and parser: agent/usr/lib/fleet-agent/identity-lib.sh.
  The rendered file must contain exactly the contract keys, in this order, as
  inert KEY=value lines — no quoting, no inline comments after a value.

  Source of truth for the values: group_vars/all/vars.yml (which declares every
  name used below, including the ones it derives from group_vars/all/vault.yml)
  + inventory vars + the facts bootstrap_device.yml sets (device_id,
  fleet_agent_token). A `| default()` here is a fallback for a variable that is
  DECLARED and legitimately optional — never a substitute for declaring it:
  tests/test_device_identity_contract.py fails on any name below that no
  group_vars, inventory or playbook fact defines.
  Re-deployed by: ansible-playbook playbooks/configure_device.yml --limit <host>
#}
# Fleet Agent Identity — generated by Ansible, do not edit manually
# Inert KEY=value data, parsed by /usr/lib/fleet-agent/identity-lib.sh
DEVICE_ID={{ device_id | default(inventory_hostname) }}
SITE_ID={{ site }}
ZONE_ID={{ zone }}
DEVICE_ROLE={{ device_role }}
PROFILE={{ profile | default('') }}
ENVIRONMENT={{ environment | default('prod') }}
RING={{ ring | default('2') }}
FLEET_API_URL={{ fleet_api_url }}
FLEET_METRICS_URL={{ fleet_metrics_url }}
FLEET_LOGS_URL={{ fleet_logs_url }}
FLEET_AGENT_TOKEN={{ fleet_agent_token }}
REPO_BASIC_TOKEN={{ repo_basic_token | default('') }}
HEADSCALE_PREAUTH_KEY={{ headscale_preauth_key | default('') }}
MQTT_BROKER_HOST={{ mqtt_broker_host | default('localhost') }}
MQTT_BROKER_PORT={{ mqtt_broker_port | default(1883) }}
MQTT_USERNAME={{ mqtt_username | default('') }}
MQTT_PASSWORD={{ mqtt_password | default('') }}
ENABLE_MQTT_EXPORTER={{ enable_mqtt_exporter | default(false) | lower }}
ENABLE_PROCESS_EXPORTER={{ enable_process_exporter | default(false) | lower }}
SCRAPE_INTERVAL={{ scrape_interval | default('30s') }}

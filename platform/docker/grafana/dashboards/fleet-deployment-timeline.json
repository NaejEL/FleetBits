{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "datasource", "id": "loki",       "name": "Loki",       "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Device online/offline history and deployment log stream per site and zone — trace when a rollout landed and which devices accepted it",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Device Availability — $site / $zone",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "1 = device reachable (Prometheus scrape succeeding), 0 = offline. Use this to correlate deployment windows with device connectivity.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 12,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "line+area" }
          },
          "mappings": [
            { "options": { "0": { "color": "red",   "index": 0, "text": "offline" },
                           "1": { "color": "green", "index": 1, "text": "online"  } },
              "type": "value" }
          ],
          "max": 1.2,
          "min": -0.1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red",   "value": null },
              { "color": "green", "value": 1    }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "up{site=~\"$site\", zone=~\"$zone\"}",
          "instant": false,
          "interval": "",
          "legendFormat": "{{device_id}}",
          "refId": "A"
        }
      ],
      "title": "Device Online / Offline",
      "type": "timeseries"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 3,
      "title": "Device Count Summary",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Devices currently online in the selected site/zone",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "green", "mode": "fixed" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 10 },
      "id": 4,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(up{site=~\"$site\", zone=~\"$zone\"} == 1)",
          "instant": true,
          "legendFormat": "Online",
          "refId": "A"
        }
      ],
      "title": "Online",
      "type": "stat"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Devices currently offline or unreachable",
      "fieldConfig": {
        "defaults": {
          "color": { "fixedColor": "red", "mode": "fixed" },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1    }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 10 },
      "id": 5,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "count(up{site=~\"$site\", zone=~\"$zone\"} == 0) or vector(0)",
          "instant": true,
          "legendFormat": "Offline",
          "refId": "A"
        }
      ],
      "title": "Offline",
      "type": "stat"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "id": 6,
      "title": "Deployment Logs",
      "type": "row"
    },

    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Log lines matching 'deploy' or 'rollout' from the selected site and zone. Use this to pinpoint exactly when a package was installed or a rollout started/completed.",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 15 },
      "id": 7,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{site=~\"$site\", zone=~\"$zone\"} |~ \"(?i)(deploy|rollout|install|upgrade|apt)\"",
          "instant": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Deployment / Package Log Stream",
      "type": "logs"
    },

    {
      "datasource": { "type": "loki", "uid": "loki" },
      "description": "Error and warning log lines from the selected zone — useful for spotting post-deployment failures",
      "fieldConfig": { "defaults": {}, "overrides": [] },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 27 },
      "id": 8,
      "options": {
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "showCommonLabels": false,
        "showLabels": false,
        "showTime": true,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{site=~\"$site\", zone=~\"$zone\"} |~ \"(?i)(error|critical|failed|fatal)\"",
          "instant": false,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Error / Warning Log Stream",
      "type": "logs"
    }

  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["fleet", "deployments", "availability"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up, site)",
        "hide": 0,
        "includeAll": true,
        "multi": false,
        "name": "site",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(up, site)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Site"
      },
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(up{site=~\"$site\"}, zone)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "zone",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(up{site=~\"$site\"}, zone)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Zone"
      }
    ]
  },
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fleet — Deployment Timeline",
  "uid": "fleet-deployment-timeline",
  "version": 1
}

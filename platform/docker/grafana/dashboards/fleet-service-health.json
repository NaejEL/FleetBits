{
  "__inputs": [],
  "__requires": [
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Systemd service state matrix across fleet devices — spot failed or inactive units before they cause an outage",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 1,
      "title": "Systemd Unit States — $zone",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Active / failed / inactive state of fleet-managed systemd units per device. Each row is a device+unit pair; green = active, red = failed, yellow = activating/deactivating, grey = inactive.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "spanNulls": false
          },
          "mappings": [
            { "options": { "0": { "color": "grey",  "index": 0, "text": "inactive"  },
                           "1": { "color": "green", "index": 1, "text": "active"    } },
              "type": "value" }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "grey",  "value": null },
              { "color": "green", "value": 1    }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 1 },
      "id": 2,
      "options": {
        "alignValue": "left",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "mergeValues": true,
        "rowHeight": 0.9,
        "showValue": "never",
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "systemd_unit_state{zone=~\"$zone\", state=\"active\"}",
          "instant": false,
          "interval": "",
          "legendFormat": "{{device_id}} / {{name}}",
          "refId": "A"
        }
      ],
      "title": "Active Unit Timeline",
      "type": "state-timeline"
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "id": 3,
      "title": "Failed Units",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Units currently in the 'failed' state — value 1 means the unit has failed. Empty table means all units are healthy.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "custom": {
            "align": "auto",
            "displayMode": "color-background",
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red",   "value": 1    }
            ]
          }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "device_id" },
            "properties": [{ "id": "custom.width", "value": 200 }] },
          { "matcher": { "id": "byName", "options": "name" },
            "properties": [{ "id": "custom.width", "value": 280 }] },
          { "matcher": { "id": "byName", "options": "zone" },
            "properties": [{ "id": "custom.width", "value": 140 }] }
        ]
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 10 },
      "id": 4,
      "options": {
        "footer": { "fields": "", "reducer": ["sum"], "show": false },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "systemd_unit_state{zone=~\"$zone\", state=\"failed\"} == 1",
          "format": "table",
          "instant": true,
          "legendFormat": "",
          "refId": "A"
        }
      ],
      "title": "Failed Units (current)",
      "type": "table",
      "transformations": [
        { "id": "organize",
          "options": {
            "excludeByName": { "Time": true, "Value": false, "__name__": true, "instance": true, "job": true, "state": true, "type": true },
            "renameByName": { "device_id": "Device", "name": "Unit", "zone": "Zone", "Value": "Failed" }
          }
        }
      ]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "id": 5,
      "title": "Restart Counts",
      "type": "row"
    },

    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Cumulative systemd unit restart count per device. Frequent restarts indicate service instability.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": {
            "axisBorderShow": false,
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "restarts",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": { "legend": false, "tooltip": false, "viz": false },
            "insertNulls": false,
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": { "type": "linear" },
            "showPoints": "never",
            "spanNulls": true,
            "stacking": { "group": "A", "mode": "none" },
            "thresholdsStyle": { "mode": "off" }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green",  "value": null },
              { "color": "yellow", "value": 3    },
              { "color": "red",    "value": 10   }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 19 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["lastNotNull", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "systemd_unit_restart_total{zone=~\"$zone\"} > 0",
          "instant": false,
          "interval": "",
          "legendFormat": "{{device_id}} / {{name}}",
          "refId": "A"
        }
      ],
      "title": "Unit Restart Count",
      "type": "timeseries"
    }

  ],
  "refresh": "1m",
  "schemaVersion": 39,
  "tags": ["fleet", "systemd", "health"],
  "templating": {
    "list": [
      {
        "current": {},
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "definition": "label_values(systemd_unit_state, zone)",
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "name": "zone",
        "options": [],
        "query": {
          "qryType": 1,
          "query": "label_values(systemd_unit_state, zone)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "type": "query",
        "label": "Zone"
      }
    ]
  },
  "time": { "from": "now-3h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Fleet — Service Health Matrix",
  "uid": "fleet-service-health",
  "version": 1
}

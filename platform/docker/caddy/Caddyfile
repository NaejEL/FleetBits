# caddy/Caddyfile — PRODUCTION
# All {$FLEET_DOMAIN} references expand to the value of the FLEET_DOMAIN env var.
# Caddy obtains Let's Encrypt certificates automatically for every subdomain.
# All upstream services are on the Docker-internal 'fleet_net' bridge network
# and are NEVER bound to a host port in production.

# ── Operator portal ───────────────────────────────────────────────────────────
{$FLEET_DOMAIN} {
    handle_path /semaphore* {
        reverse_proxy semaphore:3000
    }

    handle_path /alertmanager* {
        basic_auth {
            {$ALERTMANAGER_BASIC_AUTH_USER} {$ALERTMANAGER_BASIC_AUTH_HASH}
        }
        reverse_proxy alertmanager:9093
    }

    reverse_proxy fleet-ui:5000
}

# ── Grafana dashboards ────────────────────────────────────────────────────────
# SSO gate: validate the fleet_access cookie via Fleet API before forwarding.
# Only FleetBits-authenticated users reach Grafana — no separate Grafana login.
# On success Caddy injects X-WEBAUTH-* headers which Grafana uses to auto-login.
grafana.{$FLEET_DOMAIN} {
    forward_auth fleet-api:8000 {
        uri /api/v1/auth/grafana-verify
        copy_headers X-WEBAUTH-USER X-WEBAUTH-EMAIL X-WEBAUTH-NAME X-WEBAUTH-GROUPS
        header_up X-Fleet-Proxy-Secret {$GRAFANA_PROXY_SECRET}
    }
    reverse_proxy grafana:3000
}

# ── Fleet API (inventory, deployments, heartbeat, provision) ─────────────────
api.{$FLEET_DOMAIN} {
    handle /metrics {
        respond 403
    }
    reverse_proxy fleet-api:8000
}

# ── Prometheus remote-write receiver (edge devices push metrics here) ─────────
# Auth is enforced by fleet-api at /api/v1/telemetry/metrics/write.
metrics.{$FLEET_DOMAIN} {
    @write path /api/v1/write
    handle @write {
        rewrite * /api/v1/telemetry/metrics/write
        reverse_proxy fleet-api:8000
    }
    respond 403
}

# ── Loki log push endpoint (edge devices push logs here) ─────────────────────
# Auth is enforced by fleet-api at /api/v1/telemetry/logs/push.
logs.{$FLEET_DOMAIN} {
    @push path /loki/api/v1/push
    handle @push {
        rewrite * /api/v1/telemetry/logs/push
        reverse_proxy fleet-api:8000
    }
    respond 403
}

# ── aptly private .deb repository ────────────────────────────────────────────
repo.{$FLEET_DOMAIN} {
    @aptly_admin path /api/* /repos/* /snapshots/* /publish/*
    handle @aptly_admin {
        respond 403
    }

    @wireguard remote_ip 100.64.0.0/10
    handle @wireguard {
        @repo_public_key path /fleetbits.asc
        handle @repo_public_key {
            reverse_proxy aptly-api:8080
        }

        @repo_packages path /pool/* /dists/*
        handle @repo_packages {
            forward_auth fleet-api:8000 {
                uri /api/v1/packages/repo/authorize
                copy_headers X-Repo-Device-Id X-Repo-Site-Id
            }
            reverse_proxy aptly-api:8080
        }

        respond 403
    }
    respond "Access restricted to WireGuard mesh" 403
}

# ── Headscale WireGuard coordination server ───────────────────────────────────
headscale.{$FLEET_DOMAIN} {
    reverse_proxy headscale:8080
}

# ── Semaphore compatibility host ───────────────────────────────────────────────
# Legacy host kept for compatibility; canonical operator URL is now
# https://{$FLEET_DOMAIN}/semaphore routed through the main Fleet portal.
semaphore.{$FLEET_DOMAIN} {
    reverse_proxy semaphore:3000
}

# Caddyfile.behind-proxy — HTTP-only mode
#
# Use this Caddyfile when the FleetBits stack runs behind an upstream reverse
# proxy (nginx, Traefik, Caddy on the Proxmox host, Cloudflare, etc.) that
# terminates TLS. Caddy acts as an internal HTTP router only — no ACME/HTTPS.
#
# Activated by docker-compose.override.behind-proxy.yml which mounts this
# file over the default /etc/caddy/Caddyfile inside the container.
#
# DNS requirements:
#   fleet.yourdomain.com          → Proxmox nginx → LXC IP:80
#   grafana.fleet.yourdomain.com  → Proxmox nginx → LXC IP:80
#   api.fleet.yourdomain.com      → Proxmox nginx → LXC IP:80
#   repo.fleet.yourdomain.com     → Proxmox nginx → LXC IP:80
#   headscale.fleet.yourdomain.com→ Proxmox nginx → LXC IP:80
#   semaphore.fleet.yourdomain.com→ Proxmox nginx → LXC IP:80
#
# All routes are HTTP inside the LXC. The upstream proxy adds X-Forwarded-*
# headers; Caddy trusts them via the trusted_proxies directive.

{
    # Disable the admin API on non-loopback for security
    admin  localhost:2019
}

# ── Operator portal ────────────────────────────────────────────────────────────
http://{$FLEET_DOMAIN} {
    trusted_proxies private_ranges
    reverse_proxy fleet-ui:5000
}

# ── Grafana dashboards ─────────────────────────────────────────────────────────
http://grafana.{$FLEET_DOMAIN} {
    trusted_proxies private_ranges
    reverse_proxy grafana:3000
}

# ── Fleet API ──────────────────────────────────────────────────────────────────
http://api.{$FLEET_DOMAIN} {
    trusted_proxies private_ranges
    reverse_proxy fleet-api:8000
}

# ── Aptly .deb repository ──────────────────────────────────────────────────────
http://repo.{$FLEET_DOMAIN} {
    trusted_proxies private_ranges
    reverse_proxy aptly-api:8080
}

# ── Prometheus remote-write / query (restricted paths) ────────────────────────
http://metrics.{$FLEET_DOMAIN} {
    trusted_proxies private_ranges
    @allowed path /api/v1/write /federate /metrics /api/v1/query /api/v1/query_range /api/v1/labels
    handle @allowed {
        reverse_proxy prometheus:9090
    }
    respond 403
}

# ── Loki log push (restricted paths) ──────────────────────────────────────────
http://logs.{$FLEET_DOMAIN} {
    trusted_proxies private_ranges
    @allowed path /loki/api/v1/push
    handle @allowed {
        reverse_proxy loki:3100
    }
    respond 403
}

# ── Headscale WireGuard coordination ──────────────────────────────────────────
http://headscale.{$FLEET_DOMAIN} {
    trusted_proxies private_ranges
    reverse_proxy headscale:8080
}

# ── Semaphore Ansible runner ───────────────────────────────────────────────────
# When running behind-proxy the Proxmox nginx is responsible for restricting
# access to semaphore.fleet.* — add an allow/deny block in nginx for this.
http://semaphore.{$FLEET_DOMAIN} {
    trusted_proxies private_ranges
    reverse_proxy semaphore:3000
}
